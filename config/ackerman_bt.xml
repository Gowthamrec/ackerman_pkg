<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Sequence name="NavigateToPoseSequence">
      <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
      <FollowPath path="{path}" controller_id="RegulatedPurePursuitController"/>
      <Succeed/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigateToPose">
    <SequenceStar name="NavigateToPose">
      <GoalUpdated/>
      <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
      <ReactiveSequence name="FollowWithObstacleCheck">
        <IsPathValid path="{path}"/>
        <ReactiveFallback name="ObstacleHandler">
          <Sequence name="PauseIfObstacle">
            <ObstacleDetected/>
            <Pause duration="2.0"/>
          </Sequence>
          <FollowPath path="{path}" controller_id="RegulatedPurePursuitController"/>
        </ReactiveFallback>
      </ReactiveSequence>
      <Wait duration="0.5"/>
    </SequenceStar>
  </BehaviorTree>

</root>